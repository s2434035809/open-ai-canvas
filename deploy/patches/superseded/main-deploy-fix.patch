+	}
+	doc, err := creationDocument(canvas.PayloadJSON)
+	if err != nil {
+		t.Fatal(err)
+	}
+	nodes, err := creationObjects(doc["nodes"])
+	if err != nil {
+		t.Fatal(err)
+	}
