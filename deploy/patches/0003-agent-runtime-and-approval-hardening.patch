diff --git a/backend/internal/app/cloud_agent_pi_awaiting_approval_test.go b/backend/internal/app/cloud_agent_pi_awaiting_approval_test.go
index e8555b38..213b5064 100644
--- a/backend/internal/app/cloud_agent_pi_awaiting_approval_test.go
